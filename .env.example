# Container images
GHCR_OWNER=ject-study
GHCR_REPO=zimdugo-4th-server
IMAGE_TAG=latest
ELASTICSEARCH_IMAGE_TAG=9.2.6-nori
POSTGIS_IMAGE_TAG=16-3.5-arm64

# PostgreSQL
DB_NAME=zimdugo
DB_USERNAME=zimdugo
DB_PASSWORD=

# Authentication
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OCI Object Storage (non-secret; production uses Instance Principal)
OCI_REGION=ap-osaka-1
OCI_OBJECT_STORAGE_NAMESPACE=axuj36gr8lmm
OCI_OBJECT_STORAGE_BUCKET=zimdugo-bucket
OCI_AUTH_MODE=instance-principal
OCI_CONFIG_PROFILE=DEFAULT
OCI_OBJECT_STORAGE_UPLOAD_EXPIRE_MINUTES=10
OCI_OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760

# Gemini translation
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash-lite

# Seoul Metro locker realtime availability
SEOUL_METRO_LOCKER_API_KEY=

# JVM sizing for the OCI Ampere A1 1 OCPU / 6 GB instance
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m
